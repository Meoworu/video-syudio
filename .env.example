APP_ENV=development
APP_PORT=8010
VIDEO_STUDIO_DATA_DIR=downloads/projects

# Google Gemini Developer API. Keep keys server-side.
GOOGLE_API_KEY=
# Optional aliases: GEMINI_API_KEY or GOOGLE_CLOUD_API_KEY.
GOOGLE_TEXT_MODEL=gemini-3.6-flash
GOOGLE_OMNI_MODEL=gemini-omni-flash-preview
GOOGLE_HTTP_TIMEOUT_SECONDS=120
GOOGLE_REQUEST_TIMEOUT_SECONDS=900
GOOGLE_POLL_INTERVAL_SECONDS=5
GOOGLE_TEXT_MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.8

# MiniMax is used only for continuous narration audio.
MINIMAX_API_KEY=
MINIMAX_SPEECH_URL=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_SPEECH_VOICE_ID=male-qn-qingse
MINIMAX_SPEECH_TIMEOUT_SECONDS=180
MINIMAX_MAX_RETRIES=2

